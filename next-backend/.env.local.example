# Copy this file to .env.local and replace the value with your MongoDB Atlas URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/sample_mflix?retryWrites=true&w=majority
# Database used by /api/item routes.
DB_NAME=sample_mflix
# The React Vite app's development origin.
CORS_ORIGIN=http://localhost:5173
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-password
NODE_ENV=development
JWT_SECRET=replace-with-a-random-32-character-alphanumeric-secret
